{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
  "name": "magic-menu-block-example",
  "version-semver": "1.0.0",
  "description": "Example add-on block for Magic Menu Rewrite. Standalone build only (the HeartOfMagic super-build ignores this file): the packages CommonLibSSE-NG 10.0.0's own vcpkg.json needs, without its tests feature",
  "supports": "windows & x64",
  "dependencies": [
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    {
      "name": "directxmath",
      "version>=": "2025-04-03"
    },
    {
      "name": "directxtk",
      "version>=": "2025-10-27"
    },
    {
      "name": "fmt",
      "version>=": "12.1.0"
    },
    {
      "name": "nlohmann-json",
      "version>=": "3.12.0"
    },
    {
      "name": "rapidcsv",
      "version>=": "8.90"
    },
    {
      "name": "simpleini",
      "version>=": "4.25"
    },
    {
      "name": "spdlog",
      "version>=": "1.16.0"
    },
    {
      "name": "toml11",
      "version>=": "4.4.0"
    },
    {
      "name": "xbyak",
      "version>=": "7.28"
    }
  ]
}
