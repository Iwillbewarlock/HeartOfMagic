{
  "tier": "framework",
  "_comment": [
    "Object Categorization Framework magic effect keywords. Evidence tier 2,",
    "same caveat as KIT: only present when OCF is installed.",
    "OCF_MgefClass* is a school-of-thought axis rather than a strict element",
    "one - Druid and Necromancy name a tradition, not a substance - so those",
    "map to the element that tradition is made of."
  ],
  "rules": [

    { "_": "OCF_MgefClass* - the tradition the effect belongs to (Arcane gets no element: plain magic, decided 2026-09-27)",
      "match": { "mgefKeyword": "OCF_MgefClassArtificer" },  "add": { "elements": ["construct"] } },
    { "match": { "mgefKeyword": "OCF_MgefClassAsh" },        "add": { "elements": ["fire", "earth"] } },
    { "match": { "mgefKeyword": "OCF_MgefClassAstral" },     "add": { "elements": ["holy"] } },
    { "match": { "mgefKeyword": "OCF_MgefClassBlood" },      "add": { "elements": ["blood"] } },
    { "match": { "mgefKeyword": "OCF_MgefClassDruid" },      "add": { "elements": ["nature"] } },
    { "match": { "mgefKeyword": "OCF_MgefClassEarth" },      "add": { "elements": ["earth"] } },
    { "match": { "mgefKeyword": "OCF_MgefClassEldritch" },   "add": { "elements": ["eldritch"] } },
    { "match": { "mgefKeyword": "OCF_MgefClassFire" },       "add": { "elements": ["fire"] } },
    { "match": { "mgefKeyword": "OCF_MgefClassFrost" },      "add": { "elements": ["frost"] } },
    { "match": { "mgefKeyword": "OCF_MgefClassHoly" },       "add": { "elements": ["holy"] } },
    { "match": { "mgefKeyword": "OCF_MgefClassNecromancy" }, "add": { "elements": ["necrotic"] } },
    { "match": { "mgefKeyword": "OCF_MgefClassShadow" },     "add": { "elements": ["shadow"] } },
    { "match": { "mgefKeyword": "OCF_MgefClassShock" },      "add": { "elements": ["shock"] } },
    { "match": { "mgefKeyword": "OCF_MgefClassWater" },      "add": { "elements": ["water"] } },
    { "match": { "mgefKeyword": "OCF_MgefClassWind" },       "add": { "elements": ["air"] } },

    { "_": "OCF_MgefSpellDamage_* - what the damage is made of (Arcane: no element)",
      "match": { "mgefKeywordPrefix": "OCF_MgefSpellDamage_AshFire" }, "add": { "elements": ["fire", "earth"] } },
    { "match": { "mgefKeywordPrefix": "OCF_MgefSpellDamage_Blood" },   "add": { "elements": ["blood"] } },
    { "match": { "mgefKeyword": "OCF_MgefSpellDamage_Deconstruct" },   "add": { "elements": ["construct"] } },
    { "match": { "mgefKeywordPrefix": "OCF_MgefSpellDamage_Earth" },   "add": { "elements": ["earth"] } },
    { "match": { "mgefKeywordPrefix": "OCF_MgefSpellDamage_Fire" },    "add": { "elements": ["fire"] } },
    { "match": { "mgefKeyword": "OCF_MgefSpellDamage_Force" },         "add": { "elements": ["force"] } },
    { "match": { "mgefKeywordPrefix": "OCF_MgefSpellDamage_Frost" },   "add": { "elements": ["frost"] } },
    { "match": { "mgefKeywordPrefix": "OCF_MgefSpellDamage_FrostFire" },
      "add": { "elements": ["frost", "fire"] } },
    { "match": { "mgefKeywordPrefix": "OCF_MgefSpellDamage_Holy" },    "add": { "elements": ["holy"] } },
    { "match": { "mgefKeywordPrefix": "OCF_MgefSpellDamage_Necrotic" },"add": { "elements": ["necrotic"] } },
    { "match": { "mgefKeywordPrefix": "OCF_MgefSpellDamage_NecroticFire" },
      "add": { "elements": ["necrotic", "fire"] } },
    { "match": { "mgefKeywordPrefix": "OCF_MgefSpellDamage_Poison" },  "add": { "elements": ["poison"] } },
    { "match": { "mgefKeywordPrefix": "OCF_MgefSpellDamage_Shadow" },  "add": { "elements": ["shadow"] } },
    { "match": { "mgefKeywordPrefix": "OCF_MgefSpellDamage_Shock" },   "add": { "elements": ["shock"] } },
    { "match": { "mgefKeywordPrefix": "OCF_MgefSpellDamage_Water" },   "add": { "elements": ["water"] } },
    { "match": { "mgefKeywordPrefix": "OCF_MgefSpellDamage_Wind" },    "add": { "elements": ["air"] } },

    { "_": "cloak variants carry the same element and say how it is worn",
      "match": { "mgefKeywordPrefix": "OCF_MgefSpell", "mgefKeywordSuffix": "Cloak" },
      "add": { "techniques": ["cloak"] } },

    { "_": "OCF_MgefSpellSummon_*",
      "match": { "mgefKeyword": "OCF_MgefSpellSummon_Construct" },
      "add": { "elements": ["construct"], "techniques": ["summoning"] } },
    { "match": { "mgefKeyword": "OCF_MgefSpellSummon_Creature" },
      "add": { "elements": ["creature"], "techniques": ["summoning"] } },
    { "match": { "mgefKeyword": "OCF_MgefSpellSummon_Daedra" },
      "add": { "elements": ["daedra"], "techniques": ["summoning"] } },
    { "match": { "mgefKeyword": "OCF_MgefSpellSummon_Spirit" },
      "add": { "elements": ["apparition"], "techniques": ["summoning"] } },
    { "match": { "mgefKeyword": "OCF_MgefSpellSummon_Undead" },
      "add": { "elements": ["undead"], "techniques": ["summoning"] } },

    { "_": "conjured gear",
      "match": { "mgefKeyword": "OCF_MgefSpellBound_Weapon" },
      "add": { "elements": ["weapon", "soul"], "techniques": ["summoning", "transform"] } },
    { "match": { "mgefKeyword": "OCF_MgefSpellBound_Armor" },
      "add": { "elements": ["armor", "soul"], "techniques": ["summoning", "transform"] } },
    { "match": { "mgefKeyword": "OCF_MgefSpellBound_Ammo" },
      "add": { "elements": ["weapon", "soul"], "techniques": ["summoning", "transform"] } },

    { "_": "concepts vanilla has no keyword for",
      "match": { "mgefKeywordPrefix": "OCF_MgefSpellSpace_Teleport" },
      "add": { "techniques": ["teleport"] } },
    { "match": { "mgefKeyword": "OCF_MgefSpellSacrifice_Blood" },
      "add": { "elements": ["blood"], "techniques": ["sacrifice"] } },
    { "match": { "mgefKeyword": "OCF_MgefSpellSacrifice_Corpse" },
      "add": { "elements": ["flesh", "necrotic"], "techniques": ["sacrifice"] } },
    { "match": { "mgefKeyword": "OCF_MgefSpellSacrifice_Summon" },
      "add": { "elements": ["soul"], "techniques": ["sacrifice"] } },
    { "match": { "mgefKeyword": "OCF_MgefSpellDispel" },   "add": { "techniques": ["dispel"] } },
    { "match": { "mgefKeyword": "OCF_MgefSpellTransmute" },
      "add": { "elements": ["metal"], "techniques": ["transform"] } },

    { "_": "the rest",
      "match": { "mgefKeyword": "OCF_MgefSpellSoulTrap" },
      "add": { "elements": ["soul"], "techniques": ["siphon", "infuse"] } },
    { "match": { "mgefKeywordPrefix": "OCF_MgefSpellAbsorb_Magicka" },
      "add": { "elements": ["magicka"], "techniques": ["siphon"] } },
    { "match": { "mgefKeywordPrefix": "OCF_MgefSpellAbsorb_Stamina" },
      "add": { "elements": ["stamina"], "techniques": ["siphon"] } },
    { "match": { "mgefKeywordPrefix": "OCF_MgefSpellHeal_" },
      "add": { "elements": ["health"], "techniques": ["curing"] } },
    { "match": { "mgefKeyword": "OCF_MgefSpellHeal_Undead" },
      "add": { "elements": ["health", "undead"], "techniques": ["curing"] } },
    { "match": { "mgefKeyword": "OCF_MgefSpellHeal_Daedra" },
      "add": { "elements": ["health", "daedra"], "techniques": ["curing"] } },
    { "match": { "mgefKeyword": "OCF_MgefSpellMind_Control" }, "add": { "techniques": ["control"] } },
    { "match": { "mgefKeyword": "OCF_MgefSpellMind_Paralysis" },
      "add": { "elements": ["flesh"], "techniques": ["telekinesis"] } },
    { "match": { "mgefKeyword": "OCF_MgefSpellEthereal" },
      "add": { "elements": ["apparition"], "techniques": ["transform"] } },
    { "match": { "mgefKeyword": "OCF_MgefSpellForce" },  "add": { "elements": ["force"] } },
    { "match": { "mgefKeyword": "OCF_MgefSpellProtect_Damage" },
      "add": { "elements": ["armor"], "techniques": ["infuse"] } },
    { "match": { "mgefKeyword": "OCF_MgefSpellShield_Warmth" },
      "add": { "elements": ["resistance", "frost"], "techniques": ["strengthen"] } },
    { "match": { "mgefKeyword": "OCF_MgefSpellCurse_Necromancy" },
      "add": { "elements": ["necrotic"], "techniques": ["curse"] } },
    { "match": { "mgefKeyword": "OCF_MgefSpellCurse_Shadow" },
      "add": { "elements": ["shadow"], "techniques": ["curse"] } },
    { "match": { "mgefKeyword": "OCF_MgefSpellEnhance_Sight" }, "add": { "techniques": ["sense"] } },
    { "match": { "mgefKeywordPrefix": "OCF_MgefSpellRestore_Magicka" },
      "add": { "elements": ["magicka"], "techniques": ["strengthen"] } },
    { "match": { "mgefKeywordPrefix": "OCF_MgefSpellRestore_Stamina" },
      "add": { "elements": ["stamina"], "techniques": ["strengthen"] } },
    { "match": { "mgefKeyword": "OCF_MgefSpellEnhance_Health" },
      "add": { "elements": ["health"], "techniques": ["strengthen"] } }
  ]
}
