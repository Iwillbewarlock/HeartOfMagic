{
  "tier": "framework",
  "_comment": [
    "Keyword Item Distributor spell keywords. Evidence tier 2: present only",
    "when KIT is installed, so nothing here may be load bearing - 00_mgef.json",
    "has to stand on its own.",
    "KIT_MagicElement_* is the framework's own element axis and maps almost one",
    "to one onto ours, which is where four of our beyond-Spell-Research tags",
    "come from. Composite elements are emitted as both halves: AshFire is fire",
    "and earth, because merging is the adapter's job and splitting is nobody's."
  ],
  "rules": [

    { "_": "KIT_MagicElement_* - the framework says outright what the magic is (Arcane gets no element: plain magic, decided 2026-09-27)",
      "match": { "mgefKeyword": "KIT_MagicElement_AshFire" },  "add": { "elements": ["fire", "earth"] } },
    { "match": { "mgefKeyword": "KIT_MagicElement_Astral" },   "add": { "elements": ["holy"] } },
    { "match": { "mgefKeyword": "KIT_MagicElement_Blood" },    "add": { "elements": ["blood"] } },
    { "match": { "mgefKeyword": "KIT_MagicElement_ColdFire" }, "add": { "elements": ["fire", "frost"] } },
    { "match": { "mgefKeyword": "KIT_MagicElement_Creature" }, "add": { "elements": ["creature"] } },
    { "match": { "mgefKeyword": "KIT_MagicElement_Daedric" },  "add": { "elements": ["daedra"] } },
    { "match": { "mgefKeyword": "KIT_MagicElement_Dwarven" },  "add": { "elements": ["construct", "metal"] } },
    { "match": { "mgefKeyword": "KIT_MagicElement_Eldritch" }, "add": { "elements": ["eldritch"] } },
    { "match": { "mgefKeyword": "KIT_MagicElement_Fire" },     "add": { "elements": ["fire"] } },
    { "match": { "mgefKeyword": "KIT_MagicElement_Frost" },    "add": { "elements": ["frost"] } },
    { "match": { "mgefKeyword": "KIT_MagicElement_Holy" },     "add": { "elements": ["holy"] } },
    { "match": { "mgefKeyword": "KIT_MagicElement_Necrotic" }, "add": { "elements": ["necrotic"] } },
    { "match": { "mgefKeyword": "KIT_MagicElement_Poison" },   "add": { "elements": ["poison"] } },
    { "match": { "mgefKeyword": "KIT_MagicElement_Shadow" },   "add": { "elements": ["shadow"] } },
    { "match": { "mgefKeyword": "KIT_MagicElement_Shock" },    "add": { "elements": ["shock"] } },
    { "match": { "mgefKeyword": "KIT_MagicElement_ShockArc" }, "add": { "elements": ["shock"] } },
    { "match": { "mgefKeyword": "KIT_MagicElement_Spirit" },   "add": { "elements": ["apparition"] } },
    { "match": { "mgefKeyword": "KIT_MagicElement_Sun" },      "add": { "elements": ["sun"] } },
    { "match": { "mgefKeyword": "KIT_MagicElement_Undead" },   "add": { "elements": ["undead"] } },
    { "match": { "mgefKeyword": "KIT_MagicElement_Vampiric" }, "add": { "elements": ["undead"] } },
    { "match": { "mgefKeyword": "KIT_MagicElement_Wind" },     "add": { "elements": ["air"] } },

    { "_": "KIT_MagicSummonType_* - what is being called up",
      "match": { "mgefKeyword": "KIT_MagicSummonType_Arcane" },
      "add": { "techniques": ["summoning"] } },
    { "match": { "mgefKeyword": "KIT_MagicSummonType_ColdFire" },
      "add": { "elements": ["fire", "frost"], "techniques": ["summoning"] } },
    { "match": { "mgefKeyword": "KIT_MagicSummonType_Creature" },
      "add": { "elements": ["creature"], "techniques": ["summoning"] } },
    { "match": { "mgefKeyword": "KIT_MagicSummonType_Daedric" },
      "add": { "elements": ["daedra"], "techniques": ["summoning"] } },
    { "match": { "mgefKeyword": "KIT_MagicSummonType_Dwarven" },
      "add": { "elements": ["construct", "metal"], "techniques": ["summoning"] } },
    { "match": { "mgefKeyword": "KIT_MagicSummonType_Eldritch" },
      "add": { "elements": ["eldritch"], "techniques": ["summoning"] } },
    { "match": { "mgefKeyword": "KIT_MagicSummonType_Fire" },
      "add": { "elements": ["fire"], "techniques": ["summoning"] } },
    { "match": { "mgefKeyword": "KIT_MagicSummonType_Frost" },
      "add": { "elements": ["frost"], "techniques": ["summoning"] } },
    { "match": { "mgefKeyword": "KIT_MagicSummonType_Shadow" },
      "add": { "elements": ["shadow"], "techniques": ["summoning"] } },
    { "match": { "mgefKeywordPrefix": "KIT_MagicSummonType_Shock" },
      "add": { "elements": ["shock"], "techniques": ["summoning"] } },
    { "match": { "mgefKeyword": "KIT_MagicSummonType_Spirit" },
      "add": { "elements": ["apparition"], "techniques": ["summoning"] } },
    { "match": { "mgefKeyword": "KIT_MagicSummonType_Undead" },
      "add": { "elements": ["undead"], "techniques": ["summoning"] } },
    { "match": { "mgefKeyword": "KIT_MagicSummonType_Vampiric" },
      "add": { "elements": ["undead"], "techniques": ["summoning"] } },
    { "match": { "mgefKeyword": "KIT_MagicSummonType_Generic" },
      "add": { "techniques": ["summoning"] } },

    { "_": "KIT_MagicDamageType_* - the same subjects, on the damaging half",
      "match": { "mgefKeywordPrefix": "KIT_MagicDamageType_Blood" }, "add": { "elements": ["blood"] } },
    { "match": { "mgefKeywordPrefix": "KIT_MagicDamageType_Eldritch" }, "add": { "elements": ["eldritch"] } },
    { "match": { "mgefKeywordPrefix": "KIT_MagicDamageType_Sun" },  "add": { "elements": ["sun"] } },
    { "match": { "mgefKeywordPrefix": "KIT_MagicDamageType_Wind" }, "add": { "elements": ["air"] } },
    { "match": { "mgefKeywordPrefix": "KIT_MagicDamageType_AshFire" }, "add": { "elements": ["fire", "earth"] } },
    { "match": { "mgefKeywordPrefix": "KIT_MagicDamageType_ColdFire" }, "add": { "elements": ["fire", "frost"] } },
    { "match": { "mgefKeywordPrefix": "KIT_MagicDamageType_Shadow" }, "add": { "elements": ["shadow"] } },
    { "match": { "mgefKeywordPrefix": "KIT_MagicDamageType_Construct" }, "add": { "elements": ["construct"] } },

    { "_": "shape suffixes - a rune is laid down, a cloak is worn",
      "match": { "mgefKeywordPrefix": "KIT_Magic", "mgefKeywordSuffix": "Rune" },
      "add": { "elements": ["trap"] } },
    { "match": { "mgefKeywordPrefix": "KIT_Magic", "mgefKeywordSuffix": "Cloak" },
      "add": { "techniques": ["cloak"] } },

    { "_": "concepts vanilla has no keyword for.",
      "__": "KIT_MagicSubtype_Teleport and KIT_MagicTeleportType_Normal are NOT",
      "___": "teleport spells: KIT puts them on all 156 summons, because a summon",
      "____": "moves an actor into place. Mapping them to the teleport technique",
      "_____": "produced 24 false alarms and not one hit. Only the shadow variant,",
      "______": "which is a real shadow step, is kept.",
      "match": { "mgefKeyword": "KIT_MagicTeleportType_Shadow" },
      "add": { "elements": ["shadow"], "techniques": ["teleport"] } },
    { "match": { "mgefKeyword": "KIT_MagicSacrificeType_Blood" },
      "add": { "elements": ["blood"], "techniques": ["sacrifice"] } },
    { "match": { "mgefKeyword": "KIT_MagicDispelType_DispelNormal" },
      "add": { "techniques": ["dispel"] } },
    { "match": { "mgefKeywordPrefix": "KIT_MagicWaterbreatheType_" }, "add": { "elements": ["water"] } },
    { "match": { "mgefKeywordPrefix": "KIT_MagicWaterwalkType_" },    "add": { "elements": ["water"] } },

    { "_": "resources",
      "match": { "mgefKeyword": "KIT_MagicRestoreType_Health" },
      "add": { "elements": ["health"], "techniques": ["curing"] } },
    { "match": { "mgefKeyword": "KIT_MagicRestoreType_Magicka" },
      "add": { "elements": ["magicka"], "techniques": ["strengthen"] } },
    { "match": { "mgefKeyword": "KIT_MagicRestoreType_Stamina" },
      "add": { "elements": ["stamina"], "techniques": ["strengthen"] } },
    { "match": { "mgefKeywordPrefix": "KIT_MagicAbsorbType_Health" },
      "add": { "elements": ["health"], "techniques": ["siphon"] } },
    { "match": { "mgefKeywordPrefix": "KIT_MagicAbsorbType_Magicka" },
      "add": { "elements": ["magicka"], "techniques": ["siphon"] } },
    { "match": { "mgefKeywordPrefix": "KIT_MagicAbsorbType_Stamina" },
      "add": { "elements": ["stamina"], "techniques": ["siphon"] } },
    { "match": { "mgefKeyword": "KIT_MagicSilenceType_Normal" },
      "add": { "elements": ["magicka"], "techniques": ["curse"] } },

    { "_": "defence and resistance",
      "match": { "mgefKeywordPrefix": "KIT_MagicWardType_" },
      "add": { "elements": ["shield"], "techniques": ["strengthen"] } },
    { "match": { "mgefKeyword": "KIT_MagicSubtype_Ward" },
      "add": { "elements": ["shield"], "techniques": ["strengthen"] } },
    { "match": { "mgefKeyword": "KIT_MagicEnhanceType_Armor" },
      "add": { "elements": ["armor"], "techniques": ["infuse"] } },
    { "match": { "mgefKeyword": "KIT_MagicEnhanceType_PoisonResist" },
      "add": { "elements": ["resistance", "poison"], "techniques": ["strengthen"] } },
    { "match": { "mgefKeyword": "KIT_MagicEnhanceType_MagicResist" },
      "add": { "elements": ["resistance"], "techniques": ["strengthen"] } },
    { "match": { "mgefKeyword": "KIT_MagicDebuffType_FireResist" },
      "add": { "elements": ["resistance", "fire"], "techniques": ["curse"] } },
    { "match": { "mgefKeyword": "KIT_MagicDebuffType_FrostResist" },
      "add": { "elements": ["resistance", "frost"], "techniques": ["curse"] } },
    { "match": { "mgefKeyword": "KIT_MagicDebuffType_ShockResist" },
      "add": { "elements": ["resistance", "shock"], "techniques": ["curse"] } },
    { "match": { "mgefKeyword": "KIT_MagicDebuffType_PoisonResist" },
      "add": { "elements": ["resistance", "poison"], "techniques": ["curse"] } },

    { "_": "body and mind",
      "match": { "mgefKeyword": "KIT_MagicEnhanceType_Sneak" },
      "add": { "elements": ["shadow"], "techniques": ["cloak"] } },
    { "match": { "mgefKeyword": "KIT_MagicEnhanceType_Speed" },
      "add": { "elements": ["stamina"], "techniques": ["strengthen"] } },
    { "match": { "mgefKeyword": "KIT_MagicEnhanceType_Weight" },
      "add": { "elements": ["force"], "techniques": ["strengthen"] } },
    { "match": { "mgefKeywordPrefix": "KIT_MagicParalysisType_Normal" },
      "add": { "elements": ["flesh"], "techniques": ["telekinesis"] } },
    { "_": "the mind rules carry the technique only. The MGEF archetypes already",
      "__": "add creature and human on the same spells, and KIT draws its net a",
      "___": "little wider, so repeating them here only bought false alarms.",
      "match": { "mgefKeyword": "KIT_MagicCharmType_Normal" }, "add": { "techniques": ["pacify"] } },
    { "match": { "mgefKeyword": "KIT_MagicFrenzyType_Normal" }, "add": { "techniques": ["frenzy"] } },
    { "match": { "mgefKeywordPrefix": "KIT_MagicFearType_Normal" }, "add": { "techniques": ["fear"] } },
    { "match": { "mgefKeyword": "KIT_MagicDetectType_Normal" }, "add": { "techniques": ["sense"] } },
    { "match": { "mgefKeyword": "KIT_MagicGuideType_Normal" }, "add": { "techniques": ["sense"] } },

    { "_": "the dead",
      "match": { "mgefKeywordPrefix": "KIT_MagicReanimateType_" },
      "add": { "elements": ["undead", "soul", "flesh"],
               "techniques": ["summoning", "control", "infuse"] } },
    { "match": { "mgefKeyword": "KIT_MagicRepelType_Undead" },
      "add": { "elements": ["undead"], "techniques": ["fear"] } },
    { "match": { "mgefKeywordPrefix": "KIT_MagicSoulTrapType_Normal" },
      "add": { "elements": ["soul"], "techniques": ["siphon", "infuse"] } },

    { "_": "conjured gear and other archetype markers",
      "match": { "mgefKeywordPrefix": "KIT_MagicBoundType_" },
      "add": { "elements": ["weapon", "soul", "daedra"],
               "techniques": ["summoning", "transform"] } },
    { "match": { "mgefKeyword": "KIT_MagicArchetype_BoundArmor" },
      "add": { "elements": ["armor", "soul"], "techniques": ["summoning", "transform"] } },
    { "match": { "mgefKeyword": "KIT_MagicArchetype_Banish" },
      "add": { "elements": ["daedra"], "techniques": ["control"] } },
    { "_": "no light rules here: the Light archetype in 00_mgef.json already",
      "__": "covers them, and KIT's markers sit on spells that only carry a light",
      "___": "as a side effect.",
      "match": { "mgefKeywordPrefix": "KIT_MagicSlowTimeType_" }, "add": { "elements": ["time"] } },
    { "match": { "mgefKeyword": "KIT_MagicSubtype_SlowTime" },    "add": { "elements": ["time"] } },
    { "match": { "mgefKeyword": "KIT_MagicCommandType_Normal" },  "add": { "techniques": ["control"] } },
    { "match": { "mgefKeywordPrefix": "KIT_MagicHealMinionType_" },
      "add": { "elements": ["health"], "techniques": ["curing"] } },
    { "match": { "mgefKeywordPrefix": "KIT_MagicEtheralType_" },
      "add": { "elements": ["apparition"], "techniques": ["transform"] } },
    { "match": { "mgefKeyword": "KIT_MagicActorValue_Invisibility" }, "add": { "elements": ["shadow"] } }
  ]
}
