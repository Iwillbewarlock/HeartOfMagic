{
  "tier": "framework",
  "_comment": [
    "Arcanum keywords, shaped ADAR_SPEL_<subject>_<shape>. Evidence tier 2.",
    "This is the one framework that names earth, water, wind and nature, which",
    "the MGEF structure cannot see at all - Stoneflesh and Ironflesh have",
    "identical effect records and differ only by name.",
    "Prefixes keep their trailing underscore on purpose: ADAR_SPEL_Holy_ must",
    "not swallow ADAR_SPEL_HolyAstral_."
  ],
  "rules": [

    { "_": "subjects - the half of the keyword before the shape (Arcane_ is left without an element: arcane is not an element here, decided 2026-09-27)",
      "match": { "mgefKeywordPrefix": "ADAR_SPEL_Blood_" },     "add": { "elements": ["blood"] } },
    { "match": { "mgefKeywordPrefix": "ADAR_SPEL_Earth_" },     "add": { "elements": ["earth"] } },
    { "match": { "mgefKeywordPrefix": "ADAR_SPEL_Eldritch_" },  "add": { "elements": ["eldritch"] } },
    { "match": { "mgefKeywordPrefix": "ADAR_SPEL_FrostFire_" }, "add": { "elements": ["frost", "fire"] } },
    { "match": { "mgefKeywordPrefix": "ADAR_SPEL_Holy_" },      "add": { "elements": ["holy"] } },
    { "match": { "mgefKeywordPrefix": "ADAR_SPEL_HolyAstral_" },"add": { "elements": ["holy"] } },
    { "match": { "mgefKeywordPrefix": "ADAR_SPEL_HolyLunar_" }, "add": { "elements": ["holy"] } },
    { "match": { "mgefKeywordPrefix": "ADAR_SPEL_Nature" },     "add": { "elements": ["nature"] } },
    { "match": { "mgefKeywordPrefix": "ADAR_SPEL_Necromancy_" },
      "add": { "elements": ["necrotic", "undead"] } },
    { "match": { "mgefKeywordPrefix": "ADAR_SPEL_NecroticFire_" },
      "add": { "elements": ["necrotic", "fire"] } },
    { "match": { "mgefKeywordPrefix": "ADAR_SPEL_Poison_" },    "add": { "elements": ["poison"] } },
    { "match": { "mgefKeywordPrefix": "ADAR_SPEL_Shadow_" },    "add": { "elements": ["shadow"] } },
    { "match": { "mgefKeywordPrefix": "ADAR_SPEL_ShockArc_" },  "add": { "elements": ["shock"] } },
    { "match": { "mgefKeywordPrefix": "ADAR_SPEL_Stamina_" },   "add": { "elements": ["stamina"] } },
    { "match": { "mgefKeywordPrefix": "ADAR_SPEL_Volcanic_" },  "add": { "elements": ["fire", "earth"] } },
    { "match": { "mgefKeywordPrefix": "ADAR_SPEL_Water_" },     "add": { "elements": ["water"] } },
    { "match": { "mgefKeywordPrefix": "ADAR_SPEL_Wind_" },      "add": { "elements": ["air"] } },
    { "match": { "mgefKeywordPrefix": "ADAR_SPEL_Ferocity_" },  "add": { "techniques": ["frenzy"] } },

    { "_": "shapes - the half after the subject",
      "match": { "mgefKeywordPrefix": "ADAR_SPEL_", "mgefKeywordSuffix": "_Rune" },
      "add": { "elements": ["trap"] } },
    { "match": { "mgefKeywordPrefix": "ADAR_SPEL_", "mgefKeywordSuffix": "_Cloak" },
      "add": { "techniques": ["cloak"] } },
    { "match": { "mgefKeywordPrefix": "ADAR_SPEL_", "mgefKeywordSuffix": "_Conjuration" },
      "add": { "techniques": ["summoning"] } },
    { "match": { "mgefKeywordPrefix": "ADAR_SPEL_", "mgefKeywordSuffix": "_Shield" },
      "add": { "elements": ["shield"], "techniques": ["strengthen"] } },
    { "match": { "mgefKeywordPrefix": "ADAR_SPEL_", "mgefKeywordSuffix": "_Heal" },
      "add": { "elements": ["health"], "techniques": ["curing"] } },
    { "match": { "mgefKeywordPrefix": "ADAR_SPEL_", "mgefKeywordSuffix": "_Invisibility" },
      "add": { "elements": ["shadow"] } },

    { "_": "named behaviours",
      "match": { "mgefKeywordPrefix": "ADAR_SPEL_Holy_Summon" },
      "add": { "elements": ["weapon", "soul"], "techniques": ["summoning", "transform"] } },
    { "match": { "mgefKeywordPrefix": "ADAR_SPEL_Necromancy_Summon" },
      "add": { "elements": ["weapon", "soul"], "techniques": ["summoning", "transform"] } },
    { "match": { "mgefKeyword": "ADAR_SPEL_Necromancy_SummonUndead" },
      "add": { "elements": ["undead", "soul"], "techniques": ["summoning", "control"] } },
    { "match": { "mgefKeyword": "ADAR_SPEL_Necromancy_SacrificeCorpse" },
      "add": { "elements": ["flesh"], "techniques": ["sacrifice"] } },
    { "match": { "mgefKeyword": "ADAR_SPEL_Necromancy_ExplodeCorpse" },
      "add": { "elements": ["flesh"], "techniques": ["sacrifice"] } },
    { "match": { "mgefKeyword": "ADAR_SPEL_NatureGreen_Stagger" }, "add": { "elements": ["force"] } },
    { "match": { "mgefKeyword": "ADAR_SPEL_Arcane_Pull" },   "add": { "techniques": ["telekinesis"] } },
    { "match": { "mgefKeyword": "ADAR_SPEL_Shadow_Debuff" }, "add": { "techniques": ["curse"] } },
    { "match": { "mgefKeyword": "ADAR_SPEL_Shadow_DebuffMovement" }, "add": { "techniques": ["curse"] } }
  ]
}
