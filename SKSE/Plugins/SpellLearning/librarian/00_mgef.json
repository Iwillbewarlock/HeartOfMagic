{
  "_comment": [
    "Librarian evidence tier 1 - MGEF structure. Present in every load order,",
    "independent of language and of any keyword framework, so these rules are",
    "the ones that have to carry a plain installation.",
    "Tags start from the Spell Research vocabulary (34 elements, 15 techniques);",
    "M3 fixes the final list. Note the resist actor values are named FireResist,",
    "not ResistFire.",
    "Mappings below were read off the answer set rather than guessed: a summon",
    "carries soul, mage armor carries flesh and infuse rather than strengthen,",
    "anything aimed at a living target carries creature and human, and a spell",
    "that leaves an object standing in the world carries construct."
  ],
  "rules": [

    { "_": "vanilla damage keywords",
      "match": { "mgefKeyword": "MagicDamageFire" },   "add": { "elements": ["fire"] } },
    { "match": { "mgefKeyword": "MagicDamageFrost" },  "add": { "elements": ["frost"] } },
    { "match": { "mgefKeyword": "MagicDamageShock" },  "add": { "elements": ["shock"] } },
    { "match": { "mgefKeyword": "MagicDamageResist" }, "add": { "elements": ["resistance"] } },

    { "_": "vanilla summons - the summon keywords say what is summoned",
      "match": { "mgefKeyword": "MagicSummonFamiliar" }, "add": { "elements": ["creature"] } },
    { "match": { "mgefKeyword": "MagicSummonUndead" },
      "add": { "elements": ["undead"] } },
    { "match": { "mgefKeyword": "MagicSummonFire" },
      "add": { "elements": ["fire", "daedra"] } },
    { "match": { "mgefKeyword": "MagicSummonFrost" },
      "add": { "elements": ["frost", "daedra"] } },
    { "match": { "mgefKeyword": "MagicSummonShock" },
      "add": { "elements": ["shock", "daedra"] } },

    { "_": "vanilla influence - the generic MagicInfluence says nothing on its own",
      "match": { "mgefKeyword": "MagicInfluenceFrenzy" }, "add": { "techniques": ["frenzy"] } },
    { "match": { "mgefKeyword": "MagicInfluenceCharm" },  "add": { "techniques": ["pacify"] } },
    { "match": { "mgefKeyword": "MagicInfluenceFear" },   "add": { "techniques": ["fear"] } },

    { "_": "other vanilla keywords",
      "match": { "mgefKeyword": "MagicRestoreHealth" },
      "add": { "elements": ["health"], "techniques": ["curing"] } },
    { "match": { "mgefKeyword": "MagicRune" },
      "add": { "elements": ["trap", "construct"] } },
    { "match": { "mgefKeyword": "MagicCloak" },    "add": { "techniques": ["cloak"] } },
    { "match": { "mgefKeyword": "MagicFlameCloak" },
      "add": { "elements": ["fire"], "techniques": ["cloak"] } },
    { "match": { "mgefKeyword": "MagicVampireDrain" },
      "add": { "elements": ["health"], "techniques": ["siphon"] } },
    { "match": { "mgefKeyword": "MagicTrapPoison" },
      "add": { "elements": ["poison", "trap"] } },
    { "match": { "mgefKeyword": "MagicTurnUndead" },
      "add": { "elements": ["undead"], "techniques": ["fear"] } },
    { "match": { "mgefKeyword": "MagicWard" },
      "add": { "elements": ["shield"], "techniques": ["strengthen"] } },
    { "match": { "mgefKeyword": "MagicInvisibility" }, "add": { "elements": ["shadow"] } },
    { "match": { "mgefKeyword": "MagicNightEye" },     "add": { "techniques": ["sense"] } },
    { "match": { "mgefKeyword": "MagicTelekinesis" },  "add": { "techniques": ["telekinesis"] } },

    { "_": "summoning - a summon binds a soul into a shape and commands it.",
      "__": "Deliberately no creature tag: an atronach is daedra, not creature,",
      "___": "and the archetype cannot tell the two apart. MagicSummonFamiliar",
      "____": "and the framework summon keywords say when it really is a creature.",
      "match": { "archetype": "SummonCreature" },
      "add": { "elements": ["soul"], "techniques": ["summoning", "control"] } },
    { "match": { "archetype": "BoundWeapon" },
      "add": { "elements": ["weapon", "soul", "daedra"],
               "techniques": ["summoning", "transform"] } },
    { "match": { "archetype": "Reanimate" },
      "add": { "elements": ["undead", "soul", "flesh", "creature"],
               "techniques": ["summoning", "control", "infuse"] } },
    { "match": { "archetype": "CommandSummoned" }, "add": { "techniques": ["control"] } },
    { "match": { "archetype": "SoulTrap" },
      "add": { "elements": ["soul"], "techniques": ["siphon", "infuse"] } },

    { "_": "mind and mood - these only work on something alive",
      "match": { "archetype": "Calm" },
      "add": { "elements": ["creature", "human"], "techniques": ["pacify"] } },
    { "match": { "archetype": "Frenzy" },
      "add": { "elements": ["creature", "human"], "techniques": ["frenzy"] } },
    { "match": { "archetype": "Demoralize" },
      "add": { "elements": ["creature", "human"], "techniques": ["fear"] } },
    { "match": { "archetype": "Rally" },
      "add": { "elements": ["creature", "human"], "techniques": ["courage"] } },
    { "match": { "archetype": "DetectLife" },
      "add": { "elements": ["creature", "human"], "techniques": ["sense"] } },

    { "_": "the body - mage armor hardens flesh, paralysis seizes it",
      "match": { "mgefKeyword": "MagicArmorSpell" },
      "add": { "elements": ["armor", "flesh"], "techniques": ["infuse"] } },
    { "match": { "primaryAV": "DamageResist", "detrimental": false },
      "add": { "elements": ["armor", "flesh"], "techniques": ["infuse"] } },
    { "match": { "primaryAV": "DamageResist", "detrimental": true },
      "add": { "elements": ["armor"], "techniques": ["curse"] } },
    { "match": { "archetype": "Paralysis" },
      "add": { "elements": ["flesh"], "techniques": ["telekinesis"] } },

    { "_": "things left standing in the world",
      "match": { "archetype": "SpawnHazard" },
      "add": { "elements": ["trap", "construct"] } },
    { "match": { "archetype": "Light" },
      "add": { "elements": ["light", "construct"] } },

    { "_": "remaining archetypes",
      "match": { "archetype": "EnhanceWeapon" },
      "add": { "elements": ["weapon"], "techniques": ["infuse"] } },
    { "match": { "archetype": "TurnUndead" },
      "add": { "elements": ["undead"], "techniques": ["fear"] } },
    { "match": { "archetype": "Banish" },
      "add": { "elements": ["daedra"], "techniques": ["control"] } },
    { "match": { "archetype": "Cloak" },          "add": { "techniques": ["cloak"] } },
    { "match": { "archetype": "NightEye" },       "add": { "techniques": ["sense"] } },
    { "match": { "archetype": "Guide" },          "add": { "techniques": ["sense"] } },
    { "match": { "archetype": "Darkness" },       "add": { "elements": ["shadow"] } },
    { "match": { "archetype": "Invisibility" },   "add": { "elements": ["shadow"] } },
    { "match": { "archetype": "Telekinesis" },    "add": { "techniques": ["telekinesis"] } },
    { "match": { "archetype": "GrabActor" },      "add": { "techniques": ["telekinesis"] } },
    { "match": { "archetype": "SlowTime" },       "add": { "elements": ["time"] } },
    { "match": { "archetype": "Etherealize" },
      "add": { "elements": ["apparition"], "techniques": ["transform"] } },
    { "match": { "archetype": "Werewolf" },       "add": { "techniques": ["transform"] } },
    { "match": { "archetype": "VampireLord" },    "add": { "techniques": ["transform"] } },
    { "match": { "archetype": "Absorb" },         "add": { "techniques": ["siphon"] } },
    { "match": { "archetype": "CureDisease" },
      "add": { "elements": ["disease"], "techniques": ["curing"] } },
    { "match": { "archetype": "CurePoison" },
      "add": { "elements": ["poison"], "techniques": ["curing"] } },
    { "match": { "archetype": "CureParalysis" },  "add": { "techniques": ["curing"] } },

    { "_": "resist actor value - the element a damaging effect is resisted by",
      "match": { "resistance": "FireResist" },     "add": { "elements": ["fire"] } },
    { "match": { "resistance": "FrostResist" },    "add": { "elements": ["frost"] } },
    { "match": { "resistance": "ElectricResist" }, "add": { "elements": ["shock"] } },
    { "match": { "resistance": "PoisonResist" },   "add": { "elements": ["poison"] } },
    { "match": { "resistance": "DiseaseResist" },  "add": { "elements": ["disease"] } },

    { "_": "actor value plus direction. Health is deliberately absent: every",
      "__": "damaging spell touches it, so it separates nothing.",
      "match": { "primaryAV": "Magicka", "detrimental": false },
      "add": { "elements": ["magicka"], "techniques": ["strengthen"] } },
    { "match": { "primaryAV": "Magicka", "detrimental": true },
      "add": { "elements": ["magicka"], "techniques": ["curse"] } },
    { "match": { "primaryAV": "Stamina", "detrimental": false },
      "add": { "elements": ["stamina"], "techniques": ["strengthen"] } },
    { "match": { "primaryAV": "Stamina", "detrimental": true },
      "add": { "elements": ["stamina"], "techniques": ["curse"] } }
  ]
}
