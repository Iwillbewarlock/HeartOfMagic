{
  "_comment": [
    "Perk adapter: Atromancy 2.1 (Custom Skills tree for atronach summons). Besides the vanilla",
    "MagicSummonFire/Frost/Shock and MagicDamageFire/Frost/Shock it asks EPMagic_SpellHasKeyword for",
    "keywords Atromancy.esp defines: _ATRO_MagicSummonAtronach (Elemental Conservation, cost),",
    "_ATRO_MagicSummon<Earth|Water|Wind|Shadow|Sun> (Elemental Synergy, Legion, Diminished) and",
    "_ATRO_MagicDamage<Earth|Water|Wind|Shadow|Sun> (Diminished: the element's spells weaken while that",
    "atronach is down). Its optional add-ons put them on the effects of a fixed list of atronach and",
    "spell mods through SkyPatcher, each summon with _ATRO_MagicSummonAtronach beside its element.",
    "Summons and damage with a fire, frost or shock tag are left out: those already pass through the vanilla keywords, and the",
    "Molten-Iron add-on gives Vulcano's molten atronach no element.",
    "Known overlap: Abyss's shadow wolf has the same tags and race keywords as its shadow atronach and is marked too;",
    "the Shadow add-on leaves the wolf out.",
    "Not given: _ATRO_MagicSummonFlesh and _ATRO_MagicSummonSugar (no element tag for them). The add-ons",
    "also give the atronach races keywords and spells; that half stays theirs."
  ],
  "perkMod": "Atromancy 2.1",
  "measured": "2026-10-08",
  "requires": { "any": ["Atromancy.esp"] },
  "adapters": [
    { "keyword": "_ATRO_MagicSummonEarth", "why": "earth atronach and kin",
      "tags": { "all": ["earth", "daedra"], "none": ["fire", "frost", "shock"] }, "effect": { "archetype": "SummonCreature" },
      "keywordsNone": ["MagicSummonFire", "MagicSummonFrost", "MagicSummonShock", "MagicSummonUndead"] },
    { "keyword": "_ATRO_MagicSummonWater", "why": "water atronach and kin",
      "tags": { "all": ["water", "daedra"], "none": ["fire", "frost", "shock"] }, "effect": { "archetype": "SummonCreature" },
      "keywordsNone": ["MagicSummonFire", "MagicSummonFrost", "MagicSummonShock", "MagicSummonUndead"] },
    { "keyword": "_ATRO_MagicSummonWind", "why": "air atronach and kin",
      "tags": { "all": ["air", "daedra"], "none": ["fire", "frost", "shock"] }, "effect": { "archetype": "SummonCreature" },
      "keywordsNone": ["MagicSummonFire", "MagicSummonFrost", "MagicSummonShock", "MagicSummonUndead"] },
    { "keyword": "_ATRO_MagicSummonShadow", "why": "shadow atronach and kin",
      "tags": { "all": ["shadow", "daedra"], "none": ["fire", "frost", "shock"] }, "effect": { "archetype": "SummonCreature" },
      "keywordsNone": ["MagicSummonFire", "MagicSummonFrost", "MagicSummonShock", "MagicSummonUndead"] },
    { "keyword": "_ATRO_MagicSummonSun", "why": "sun atronach and kin",
      "tags": { "all": ["sun", "daedra"], "none": ["fire", "frost", "shock"] }, "effect": { "archetype": "SummonCreature" },
      "keywordsNone": ["MagicSummonFire", "MagicSummonFrost", "MagicSummonShock", "MagicSummonUndead"] },
    { "keyword": "_ATRO_MagicSummonAtronach", "why": "any atronach the lines above marked - the add-ons put it beside each element",
      "effect": { "archetype": "SummonCreature" },
      "keywordsNone": ["MagicSummonFire", "MagicSummonFrost", "MagicSummonShock", "MagicSummonUndead"],
      "tags": { "all": ["daedra"], "any": ["earth", "water", "air", "shadow", "sun"], "none": ["fire", "frost", "shock"] } },

    { "keyword": "_ATRO_MagicDamageEarth", "why": "earth damage",
      "tags": { "all": ["earth"], "none": ["fire", "frost", "shock"] }, "effect": { "detrimental": true, "primaryAV": "Health" } },
    { "keyword": "_ATRO_MagicDamageWater", "why": "water damage",
      "tags": { "all": ["water"], "none": ["fire", "frost", "shock"] }, "effect": { "detrimental": true, "primaryAV": "Health" } },
    { "keyword": "_ATRO_MagicDamageWind", "why": "air damage",
      "tags": { "all": ["air"], "none": ["fire", "frost", "shock"] }, "effect": { "detrimental": true, "primaryAV": "Health" } },
    { "keyword": "_ATRO_MagicDamageShadow", "why": "shadow damage",
      "tags": { "all": ["shadow"], "none": ["fire", "frost", "shock"] }, "effect": { "detrimental": true, "primaryAV": "Health" } },
    { "keyword": "_ATRO_MagicDamageSun", "why": "sun damage",
      "tags": { "all": ["sun"], "none": ["fire", "frost", "shock"] }, "effect": { "detrimental": true, "primaryAV": "Health" } }
  ]
}
